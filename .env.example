# Runtime tier. Production and staging fail fast when required secrets are absent.
APP_ENV=local

# Supabase project credentials — Project Settings → API in the Supabase dashboard.
# Without these the app runs in demo mode with sample listings.
NEXT_PUBLIC_SUPABASE_URL=
# New-style publishable key (sb_publishable_...); legacy anon keys also work
# via NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret/service key for scheduled jobs and notification
# workers. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Postgres connection strings (Dashboard → Connect). Only needed for applying
# migrations/seeds from this machine — never shipped to the browser.
DATABASE_URL=
DIRECT_URL=

# Public application origin used in metadata and notification links.
# Production: https://spaces.dzaleka.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email notifications. Leave RESEND_API_KEY empty to keep the adapter disabled.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="Dzaleka Spaces <spaces@dzaleka.com>"
EMAIL_REPLY_TO=info@mail.dzaleka.com

# Shared secret expected by /api/jobs/process-notifications.
NOTIFICATION_WORKER_SECRET=

# Read-only reconciliation for DzalekaPay transactions created outside this
# platform. Keep disabled until the scoped read key and signed webhook pass the
# runbook verification. Never grant payments:write to this integration.
DZALEKAPAY_RECONCILIATION_ENABLED=false
DZALEKAPAY_API_KEY=
DZALEKAPAY_WEBHOOK_SECRET=
DZALEKAPAY_MERCHANT_ID=
DZALEKAPAY_BASE_URL=https://pay.dzaleka.com
